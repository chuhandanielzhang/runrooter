struct wheel_cmd_lcmt {
    int64_t timestamp;
// MOBILE kiwi drive: 3x RM M2006/C610 wheels evenly spaced 120 deg apart
// on the base circle (replaces DaMiao DM-H6215 hubs). Wheel axes point
// at the chassis center, so each wheel drives tangentially (omni rollers
// carry the side slip). Jetson RmWheelController closes a speed PI and
// emits C610 current on can1.
// Wheel angular speed command (rad/s, OUTPUT shaft after 36:1), positive
// = wheel rolls CCW about its axis as seen from OUTSIDE the chassis.
    float speed_des_rad_s[3];
    // 1 = drive (upper controller is in MOBILE and enabled);
    // 0 = coast/stop (every other mode). The Jetson driver must also
    // apply its own mode gating (X arms / B cuts), same as rm_iq_des.
    int8_t enable;
}
