# CANable2 adapters running candleLight (gs_usb) firmware -> native SocketCAN.
#
# 2026-08-12: slcan/slcand retired. With gs_usb the kernel driver owns the
# netdev directly: a USB reset (e.g. the tegra-xusb hub reset that froze all
# 3 AK60s mid-flight on 2026-08-12) simply removes and re-adds the netdev,
# udev re-triggers the setup unit, and the bus heals in <1s -- no zombie
# slcand, no deleted-tty state, no 10s watchdog detection lag.
#
# Naming is done by can_gsusb_setup.sh (rename with retry), NOT by NAME= here:
# the kernel hands out can0/can1 in probe order and Tegra's onboard mttcan
# grabs "can0" at boot, so a one-shot udev rename can collide.
#
#   004D00663945501620303651  -> can0 (legs AK60/DM4310 bus,  1Mbit)
#   0067005F3945501620303651 -> can1 (RM M2006 wheel bus,    1Mbit, hot-plug optional)
#
# Tegra onboard mttcan: rename away from "can0" at boot so the legs adapter
# can own the name (was previously done in canable.service ExecStartPre).
SUBSYSTEM=="net", ACTION=="add", KERNELS=="c310000.mttcan", NAME="mtt0"

# candleLight netdevs: match by the USB device serial of the parent, tag for
# systemd and pull the per-bus setup oneshot (rename + bitrate + up).
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="usb", ATTRS{serial}=="004D00663945501620303651", TAG+="systemd", ENV{SYSTEMD_WANTS}="can0-gsusb.service"
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="usb", ATTRS{serial}=="0067005F3945501620303651", TAG+="systemd", ENV{SYSTEMD_WANTS}="can1-gsusb.service"
